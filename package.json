{
  "name": "voucher-system-be",
  "packageManager": "yarn@4.9.2",
  "scripts": {
    "dev:local": "nodemon -r dotenv/config --exec ts-node src/server.ts dotenv_config_path=.env.local",
    "dev:cloud": "nodemon -r dotenv/config --exec ts-node src/server.ts dotenv_config_path=.env.production",
    "dev": "yarn dev:local",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:prod": "NODE_ENV=production node -r dotenv/config dist/server.js dotenv_config_path=.env.production",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint . --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "seed": "ts-node src/scripts/seed.ts",
    "clear:ratelimit": "ts-node src/scripts/clear-rate-limit.script.ts",
    "clear:ratelimit:api": "ts-node src/scripts/clear-rate-limit.script.ts 'rl:api:*'",
    "clear:ratelimit:auth": "ts-node src/scripts/clear-rate-limit.script.ts 'rl:auth:*'",
    "clear:ratelimit:voucher": "ts-node src/scripts/clear-rate-limit.script.ts 'rl:voucher:*'"
  },
  "dependencies": {
    "@scalar/express-api-reference": "^0.8.25",
    "agenda": "^5.0.0",
    "bcrypt": "^6.0.0",
    "bull": "^4.16.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "i18next": "^25.7.1",
    "i18next-fs-backend": "^2.6.1",
    "ioredis": "^5.8.2",
    "joi": "^18.0.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.0.0",
    "rate-limit-redis": "^4.3.1",
    "resend": "^6.5.2",
    "socket.io": "^4.8.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.1.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/ioredis": "^5.0.0",
    "@types/ioredis-mock": "^8",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.10.1",
    "@types/socket.io": "^3.0.2",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^11.0.0",
    "@typescript-eslint/eslint-plugin": "^8.48.1",
    "@typescript-eslint/parser": "^8.48.1",
    "esbuild": "^0.27.0",
    "eslint": "^9.39.1",
    "husky": "^9.1.7",
    "ioredis-mock": "^8.13.1",
    "jest": "^30.2.0",
    "lint-staged": "^16.2.7",
    "nodemon": "^3.1.11",
    "prettier": "^3.7.3",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
