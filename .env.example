# Server Configuration
NODE_ENV=development
PORT=3000
HOST=localhost
API_PREFIX=/api/v1

# Database
MONGODB_URI=mongodb://localhost:27017/voucher-system

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT Configuration
JWT_ACCESS_SECRET=your-super-secret-access-key-change-in-production-min-32-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production-min-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
JWT_REFRESH_EXPIRY_REMEMBER_ME=30d

# Email Service (Resend)
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=onboarding@resend.dev
EMAIL_FROM_NAME=Voucher System

# Edit Lock Configuration
EDIT_LOCK_DURATION=300000

# CORS Configuration
CORS_ORIGIN=http://localhost:3001
CORS_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Internationalization
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,vi

# Socket.io
SOCKET_CORS_ORIGIN=http://localhost:3001

# Bull Queue
BULL_REDIS_HOST=localhost
BULL_REDIS_PORT=6379

# Logging
LOG_LEVEL=debug

# API Documentation
ENABLE_DOCS=true
DOCS_PATH=/docs
SWAGGER_PATH=/api-docs
